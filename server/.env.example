# give some port number that is not in use for the server to listen on
PORT=xxxx

# client origin port, defalut to 5173
CLIENT_ORIGIN=http://localhost:xxxx

# assuming your docker-compose maps redis to port 6379 (the default)
REDIS_URL=redis://localhost:6379

# the syntax, DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE"
# replace USER, PASSWORD, HOST, PORT and DATABASE with your postgres credentials that is mentioned in the docker-compse.yml file
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE"